# Application Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Neon / Local Docker Compose)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/resetly

# CORS (Comma-separated allowed origins, e.g. mobile dev server or web)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT Authentication (HS256)
JWT_ACCESS_SECRET=your-minimum-16-char-jwt-secret-here
JWT_ACCESS_TTL=15m

# Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Push Notifications (Optional Expo access token)
EXPO_ACCESS_TOKEN=
