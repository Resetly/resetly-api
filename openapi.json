{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "System health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check API and database connectivity",
        "tags": ["health"]
      }
    },
    "/v1/auth/session": {
      "get": {
        "operationId": "AuthController_getSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current user session (Strictly rate-limited)",
        "tags": ["auth"]
      }
    },
    "/v1/users/profile": {
      "get": {
        "operationId": "UsersController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current user profile information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current user profile",
        "tags": ["users"]
      }
    },
    "/v1/habits": {
      "post": {
        "operationId": "HabitsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHabitDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The habit has been successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a new habit for the authenticated user",
        "tags": ["habits"]
      },
      "get": {
        "operationId": "HabitsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of habits belonging to the current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HabitResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List all habits for the authenticated user",
        "tags": ["habits"]
      }
    },
    "/v1/habits/{id}": {
      "get": {
        "operationId": "HabitsController_findById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Habit details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a specific habit by ID",
        "tags": ["habits"]
      },
      "patch": {
        "operationId": "HabitsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHabitDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated habit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a habit by ID",
        "tags": ["habits"]
      },
      "delete": {
        "operationId": "HabitsController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The habit was successfully deleted."
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a habit by ID",
        "tags": ["habits"]
      }
    },
    "/v1/journeys/habit/{habitId}": {
      "get": {
        "operationId": "JourneysController_getJourneys",
        "parameters": [
          {
            "name": "habitId",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of journeys for the habit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JourneyResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get journeys for a habit (scoped to authenticated user)",
        "tags": ["journeys"]
      }
    },
    "/v1/check-ins/journey/{journeyId}": {
      "get": {
        "operationId": "CheckInsController_getCheckIns",
        "parameters": [
          {
            "name": "journeyId",
            "required": true,
            "in": "path",
            "description": "Journey UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of check-ins for the journey",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CheckInResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get check-ins for a journey (scoped to authenticated user)",
        "tags": ["check-ins"]
      }
    },
    "/v1/progress/journey/{journeyId}": {
      "get": {
        "operationId": "ProgressController_getJourneyProgress",
        "parameters": [
          {
            "name": "journeyId",
            "required": true,
            "in": "path",
            "description": "Journey UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Derived progress and streak metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressStatsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get derived streak and progress stats for a journey",
        "tags": ["progress"]
      }
    },
    "/v1/notifications/tokens": {
      "post": {
        "operationId": "NotificationsController_registerToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPushTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device token registered successfully"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Register a device push token for the authenticated user",
        "tags": ["notifications"]
      }
    },
    "/v1/account/me": {
      "delete": {
        "operationId": "AccountController_deleteAccount",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Account and all data successfully erased",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Permanently delete user account and all cascaded data",
        "tags": ["account"]
      }
    }
  },
  "info": {
    "title": "Resetly API",
    "description": "Privacy-first, habit-transformation API. Streaks are dynamic and progress is never fabricated.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Health and system diagnostics"
    },
    {
      "name": "auth",
      "description": "Authentication and session management"
    },
    {
      "name": "habits",
      "description": "Habits management (user-scoped)"
    },
    {
      "name": "journeys",
      "description": "Habit journeys and tracking milestones"
    },
    {
      "name": "check-ins",
      "description": "Daily check-in logs"
    },
    {
      "name": "progress",
      "description": "Derived streaks and transformation progress"
    },
    {
      "name": "notifications",
      "description": "Push notification tokens"
    },
    {
      "name": "account",
      "description": "Data privacy and account erasure"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "timestamp": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": ["connected", "disconnected"]
          }
        },
        "required": ["status", "timestamp", "database"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": ["id", "email", "createdAt", "updatedAt"]
      },
      "CreateHabitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["name", "category"]
      },
      "HabitResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": ["id", "userId", "name", "description", "category", "createdAt", "updatedAt"]
      },
      "UpdateHabitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "JourneyResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "habitId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "startDate": {
            "type": "string"
          },
          "goal": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": ["active", "paused", "archived"]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": ["id", "habitId", "startDate", "goal", "status", "createdAt", "updatedAt"]
      },
      "CheckInResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "journeyId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "date": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": ["maintained", "setback"]
          },
          "note": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "journeyId", "date", "outcome", "note", "createdAt"]
      },
      "ProgressStatsDto": {
        "type": "object",
        "properties": {
          "currentStreak": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "longestStreak": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalSuccessfulDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalCheckIns": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["currentStreak", "longestStreak", "totalSuccessfulDays", "totalCheckIns"]
      },
      "RegisterPushTokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": ["ios", "android", "web"]
          }
        },
        "required": ["token", "platform"]
      },
      "AccountDeletionResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "deletedAt": {
            "type": "string"
          }
        },
        "required": ["message", "deletedAt"]
      }
    }
  }
}
