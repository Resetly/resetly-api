{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "System health status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check API and database connectivity",
        "tags": ["health"]
      }
    },
    "/v1/habits": {
      "post": {
        "operationId": "HabitsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHabitDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The habit has been successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Create a new habit for the authenticated user",
        "tags": ["habits"]
      },
      "get": {
        "operationId": "HabitsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of habits belonging to the current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HabitResponseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List all habits for the authenticated user",
        "tags": ["habits"]
      }
    },
    "/v1/habits/{id}": {
      "get": {
        "operationId": "HabitsController_findById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Habit details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a specific habit by ID",
        "tags": ["habits"]
      },
      "patch": {
        "operationId": "HabitsController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHabitDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated habit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update a habit by ID",
        "tags": ["habits"]
      },
      "delete": {
        "operationId": "HabitsController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Habit UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The habit was successfully deleted."
          },
          "404": {
            "description": "Habit not found."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a habit by ID",
        "tags": ["habits"]
      }
    }
  },
  "info": {
    "title": "Resetly API",
    "description": "Privacy-first, habit-transformation API. Streaks are dynamic and progress is never fabricated.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": "Health and system diagnostics"
    },
    {
      "name": "habits",
      "description": "Habits management (user-scoped)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"]
          },
          "timestamp": {
            "type": "string"
          },
          "database": {
            "type": "string",
            "enum": ["connected", "disconnected"]
          }
        },
        "required": ["status", "timestamp", "database"]
      },
      "CreateHabitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["name", "category"]
      },
      "HabitResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": ["id", "userId", "name", "description", "category", "createdAt", "updatedAt"]
      },
      "UpdateHabitDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  }
}
